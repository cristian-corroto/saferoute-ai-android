<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/gradient_top">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="SafeRoute"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-condensed"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1DDB94"/>

            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="1dp"/>

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● API conectada"
                android:textSize="11sp"
                android:textColor="#1DDB94"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical"
            android:background="#0D1117">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:background="@drawable/search_field_bg"
                android:layout_marginEnd="8dp">

                <EditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="14dp"
                    android:paddingEnd="40dp"
                    android:hint="Buscar ciudad o pueblo..."
                    android:textColorHint="#4A5568"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"/>

                <TextView
                    android:id="@+id/btnLimpiarBusqueda"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#627089"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:visibility="gone"/>
            </FrameLayout>

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/search_btn_bg">

                <Button
                    android:id="@+id/btnBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="🔍"
                    android:textSize="16sp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null"
                    android:padding="0dp"/>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <fragment
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <View
                android:id="@+id/mapScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#08111B"
                android:alpha="0.08"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="#1DDB94"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:orientation="vertical"
                android:background="#C40B1018"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIESGO"
                    android:textColor="#5A6478"
                    android:textSize="9sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="5dp">
                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#E24B4A"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Alto"
                        android:textColor="#8892A4"
                        android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="5dp">
                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#EF9F27"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Medio"
                        android:textColor="#8892A4"
                        android:textSize="10sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="#1DDB94"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Seguro"
                        android:textColor="#8892A4"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:background="@drawable/bottom_sheet_bg"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/sheetCollapsedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="10dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="12dp">

                <View
                    android:id="@+id/sheetHandle"
                    android:layout_width="46dp"
                    android:layout_height="5dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/sheet_handle_bg"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIMULAR ZONA"
                            android:textSize="11sp"
                            android:textColor="#5A6478"
                            android:letterSpacing="0.15"/>

                        <TextView
                            android:id="@+id/tvResumenZona"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Sin zona seleccionada"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:id="@+id/tvResumenEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Toca el mapa o busca una zona"
                            android:textSize="12sp"
                            android:textColor="#8892A4"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hora"
                    android:textSize="12sp"
                    android:textColor="#8892A4"
                    android:layout_marginBottom="4dp"/>

                <SeekBar
                    android:id="@+id/seekHora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="23"
                    android:splitTrack="false"
                    android:layout_marginBottom="14dp"
                    android:progressTint="#1DDB94"
                    android:thumbTint="#1DDB94"
                    android:progressBackgroundTint="#1E2636"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Afluencia estimada"
                        android:textSize="12sp"
                        android:textColor="#8892A4"/>

                    <TextView
                        android:id="@+id/tvDensidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25%"
                        android:textSize="12sp"
                        android:textColor="#1DDB94"
                        android:textStyle="bold"
                        android:background="@drawable/prob_badge_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Día de la semana"
                    android:textSize="12sp"
                    android:textColor="#8892A4"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView android:id="@+id/chipLun" style="@style/DayChipDark" android:text="L"/>
                    <TextView android:id="@+id/chipMar" style="@style/DayChipDark" android:text="M"/>
                    <TextView android:id="@+id/chipMie" style="@style/DayChipDark" android:text="X"/>
                    <TextView android:id="@+id/chipJue" style="@style/DayChipDark" android:text="J"/>
                    <TextView android:id="@+id/chipVie" style="@style/DayChipDark" android:text="V"/>
                    <TextView android:id="@+id/chipSab" style="@style/DayChipDark" android:text="S"/>
                    <TextView android:id="@+id/chipDom" style="@style/DayChipDark" android:text="D"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGps"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:text="📍 Mi GPS"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#1DDB94"
                        android:stateListAnimator="@null"/>

                    <Button
                        android:id="@+id/btnAhora"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:text="🕐 Ahora"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1A2640"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#12192A"
                    app:strokeColor="#1D2435"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp">

                        <View
                            android:id="@+id/viewRiskStripe"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:background="#1DDB94"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvNivelIcono"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:gravity="center"
                                android:textSize="20sp"
                                android:background="@drawable/icon_badge_bg"
                                android:text="🟢"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingHorizontal="12dp">

                                <TextView
                                    android:id="@+id/tvNivel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ZONA SEGURA"
                                    android:textColor="#1DDB94"
                                    android:textSize="14sp"
                                    android:letterSpacing="0.08"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/tvZona"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textColor="#8892A4"
                                    android:paddingTop="2dp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/prob_badge_bg"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:id="@+id/tvProbabilidad"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12%"
                                    android:textColor="#1DDB94"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:gravity="center"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="riesgo"
                                    android:textColor="#4A5568"
                                    android:textSize="9sp"
                                    android:gravity="center"
                                    android:letterSpacing="0.06"/>
                            </LinearLayout>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressRiesgo"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="12dp"
                            android:progressDrawable="@drawable/risk_bar_fill"
                            android:progress="12"
                            android:max="100"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="16dp"
                            android:background="#1A2235"/>

                        <TextView
                            android:id="@+id/tvConsejo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="4dp"
                            android:textColor="#CDD5E0"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.35"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🕐"
                                android:textSize="11sp"/>

                            <TextView
                                android:id="@+id/tvDetalle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="6dp"
                                android:textColor="#4A5568"
                                android:textSize="11sp"
                                android:letterSpacing="0.04"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>